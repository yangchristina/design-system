{
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "declaration": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "jsx": "react",
        "module": "esnext",
        "moduleResolution": "node",
        // "emitDeclarationOnly": true,
        "noEmit": true,
        "outDir": "dist",
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "strict": true,
        "target": "es6",
        "noImplicitAny": false,
        "lib": ["dom", "dom.iterable", "es2017", "esnext"],
        "allowJs": true,
        "isolatedModules": true,
        "incremental": true,
        "plugins": [
            {
                "name": "next"
            }
        ]
    },
    "include": ["src/", "**/*.module.css", "../hooks/src/useCurrentState.ts"],
    "exclude": ["node_modules", "pages", "dist", "build", "**/*.test.ts", "**/*.test.tsx", ".next/types/**/*.ts"]
}
